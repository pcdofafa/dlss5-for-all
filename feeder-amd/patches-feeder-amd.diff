+// Carrega o nvngx_dlssnr.dll e resolve os cinco exports. Procura ao lado do
+// executavel do jogo primeiro -- e de onde o add-on de terceiros o pega e onde o
+// NGX espera encontra-lo -- e depois ao lado do add-on, que e onde o pacote deste
+// projeto costuma deixar o arquivo. 'dir' recebe o diretorio escolhido: e ele que
+// vai como InApplicationDataPath do Init_Ext, sem barra no fim, como o parent_path
+// que o add-on calcula.
+static bool NrAttachSnippet(wchar_t *dir, size_t dir_chars)
+{
+    wchar_t path[MAX_PATH] = {};
+    for (int from_addon = 0; from_addon < 2 && g_nr_snippet == nullptr; ++from_addon)
+    {
+        if (GetModuleFileNameW(from_addon ? g_self : nullptr, path, MAX_PATH) == 0) continue;
+        wchar_t *slash = wcsrchr(path, L'\\');
+        if (slash == nullptr) continue;
+        *slash = L'\0';
+        if (wcslen(path) + 1 + wcslen(kNrSnippetName) >= MAX_PATH) continue;
+        wcsncpy_s(dir, dir_chars, path, _TRUNCATE);
+        wcscat_s(path, MAX_PATH, L"\\");
+        wcscat_s(path, MAX_PATH, kNrSnippetName);
+        if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) continue;
+        // Antes de carregar: alguem ja o tem no processo? Se sim, o LoadLibraryW
+        // abaixo devolve o MESMO HMODULE e so incrementa o refcount -- e o
+        // Shutdown1 do teardown passaria por cima da sessao desse alguem.
+        g_nr_snippet_was_loaded = GetModuleHandleW(kNrSnippetName) != nullptr;
+        g_nr_snippet = LoadLibraryW(path);
+        if (g_nr_snippet == nullptr)
+        { Log("[feed] nr_spike: LoadLibraryW failed for %ls (error %lu)", path, GetLastError()); continue; }
+        Log("[feed] nr_spike: attached snippet %ls%s", path,
+            g_nr_snippet_was_loaded ? " (already in the process -- another add-on owns a session on it)" : "");
+    }
+    if (g_nr_snippet == nullptr)
+    { Log("[feed] nr_spike: %ls not found next to the game executable or next to the add-on", kNrSnippetName); return false; }
+
+    bool complete = true;
+    for (int i = 0; i < NR_EXPORT_COUNT; ++i)
+    {
+        g_nr_fn[i] = GetProcAddress(g_nr_snippet, kNrExports[i]);
+        if (g_nr_fn[i] != nullptr) continue;
+        Log("[feed] nr_spike: the snippet is missing a required lifecycle export: %s", kNrExports[i]);
+        complete = false;
+    }
+    if (complete) NrInstallCallerSpoof();   // o snippet checa a identidade do chamador em Init_Ext (e talvez adiante)
+    return complete;
+}
+
+// A sobrecarga de QUATRO argumentos do Init do core -- a do NGX_SNIPPET_BUILD.
+// Resolvida a mao no modulo do driver de proposito: o forwarder do projeto repassa
+// a assinatura publica, de cinco.
+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrCoreInit)(unsigned long long, const wchar_t *,
+                                                      ID3D12Device *, NVSDK_NGX_Version);
+
+// Mesma guarda de CreateDLSSGuarded: um access violation dentro do NGX vira log,
+// nao queda do jogo. Sem objetos C++ nos blocos protegidos, como manda o /EHsc.
+static NVSDK_NGX_Result NrCoreInitGuarded(PFN_NrCoreInit fn, const wchar_t *dir, DWORD *code)
+{
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { *code = guard.code; return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+    const NVSDK_NGX_Result r = fn(kNrApplicationId, dir, g.dev12, NVSDK_NGX_Version_API);
+    FeedGuardDisarm(&guard);
+    return r;
+#else
+    __try { return fn(kNrApplicationId, dir, g.dev12, NVSDK_NGX_Version_API); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+#endif
+}
+
+static NVSDK_NGX_Result NrInitExtGuarded(const wchar_t *dir, DWORD *code)
+{
+    const PFN_NrInitExt fn = reinterpret_cast<PFN_NrInitExt>(g_nr_fn[NR_INIT_EXT]);
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { *code = guard.code; return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+    const NVSDK_NGX_Result r = fn(kNrApplicationId, dir, g.dev12, NVSDK_NGX_Version_API, nullptr);
+    FeedGuardDisarm(&guard);
+    return r;
+#else
+    __try { return fn(kNrApplicationId, dir, g.dev12, NVSDK_NGX_Version_API, nullptr); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+#endif
+}
+
+static NVSDK_NGX_Result CreateNrGuarded(NVSDK_NGX_Parameter *p, NVSDK_NGX_Handle **out, DWORD *code)
+{
+    const PFN_NrCreate fn = reinterpret_cast<PFN_NrCreate>(g_nr_fn[NR_CREATE]);
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { *code = guard.code; return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+    const NVSDK_NGX_Result r = fn(g.list, NVSDK_NGX_Feature_Reserved18, p, out);
+    FeedGuardDisarm(&guard);
+    return r;
+#else
+    __try { return fn(g.list, NVSDK_NGX_Feature_Reserved18, p, out); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+#endif
+}
+
+static void NrReleaseGuarded(NVSDK_NGX_Handle *f)
+{
+    const PFN_NrRelease fn = reinterpret_cast<PFN_NrRelease>(g_nr_fn[NR_RELEASE]);
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { Log("[feed] nr_spike: snippet ReleaseFeature raised exception 0x%08X (ignored)", guard.code); return; }
+    fn(f);
+    FeedGuardDisarm(&guard);
+#else
+    __try { fn(f); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { Log("[feed] nr_spike: snippet ReleaseFeature raised exception 0x%08X (ignored)", GetExceptionCode()); }
+#endif
+}
+
+static NVSDK_NGX_Result NrShutdownGuarded(DWORD *code)
+{
+    const PFN_NrShutdown1 fn = reinterpret_cast<PFN_NrShutdown1>(g_nr_fn[NR_SHUTDOWN1]);
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { *code = guard.code; return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+    const NVSDK_NGX_Result r = fn(g.dev12);
+    FeedGuardDisarm(&guard);
+    return r;
+#else
+    __try { return fn(g.dev12); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+#endif
+}
+
+// Desfaz o attach. 'session' diz se o nosso Init_Ext chegou a passar.
+//
+// Sobre o Shutdown1, que agora e chamado com o NOSSO device: pela definicao da
+// API ele derruba apenas a instancia daquele device, e o add-on de terceiros tem
+// o device dele -- ou seja, estruturalmente ja nao ha como um alcancar o outro, e
+// a guarda abaixo deixou de ser necessaria por esse motivo. Mantenho-a mesmo
+// assim, por uma duvida menor que nao consigo resolver lendo o binario: o contrato
+// "por device" e da API publica do NGX, e nada garante que o snippet conte
+// instancias em vez de desmontar estado global no primeiro Shutdown1 que receber.
+// Enquanto o modulo for compartilhado com outro dono, o custo de nao desligar e
+// uma instancia nossa viva ate o fim do processo; o custo de desligar errado seria
+// derrubar o Neural Rendering dele no meio do quadro. No teste limpo -- sem o
+// concorrente na pasta, que e o cenario de referencia -- o Shutdown1 roda normal.
+//
+// nullptr NUNCA e passado ao Shutdown1: isso derrubaria todas as instancias do
+// processo, a do Super Resolution junto.
+//
+// O FreeLibrary e sempre seguro: e contado por referencia e so casa o nosso
+// LoadLibraryW. Quando ninguem mais tem o modulo, o refcount chega a zero e o
+// descarregamento acontece depois do Shutdown1, na ordem certa.
+static void NrDetachSnippet(bool session);   // definida abaixo
+
+static NVSDK_NGX_Result NrEvaluateGuarded(DWORD *code)
+{
+    const PFN_NrEvaluate fn = reinterpret_cast<PFN_NrEvaluate>(g_nr_fn[NR_EVALUATE]);
+#ifdef FEED_AMD_VARIANT
+    FeedGuard guard;
+    if (FEED_GUARD_ARM(guard)) { *code = guard.code; return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+    const NVSDK_NGX_Result r = fn(g.list, g_nr_feature, g_nr_params, nullptr);
+    FeedGuardDisarm(&guard);
+    return r;
+#else
+    __try { return fn(g.list, g_nr_feature, g_nr_params, nullptr); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+#endif
+}
+
+// Solta tudo do NR. Chamada no rebuild da feature de SR e no teardown da sessao.
+// O Shutdown1 e o FreeLibrary vao por NrDetachSnippet, que ja cuida do spoof.
+static void NrShutdown()
+{
+    if (g_nr_feature != nullptr) { NrReleaseGuarded(g_nr_feature); g_nr_feature = nullptr; }
+    if (g_nr_params  != nullptr) { NVSDK_NGX_D3D12_DestroyParameters(g_nr_params); g_nr_params = nullptr; }
+    SafeRelease(g_nr_tex[0]);
+    SafeRelease(g_nr_tex[1]);
+    const bool had = g_nr_live;
+    g_nr_live = false;
+    g_nr_w = g_nr_h = 0;
+    NrDetachSnippet(had);
+    g_nr_reset_history = true;
+}
+
+// As duas texturas da cascata, no tamanho de saida. Formato: o mesmo do SLOT_OUTPUT
+// do feed, para o passe 1 consumir exatamente o que o SuperSampling produziu sem
+// conversao pelo caminho. UAV porque a rede escreve nelas -- e o flag 0x4 que o
+// add-on de terceiros usa no private output dele.
+static bool NrCreateTextures(UINT w, UINT h)
+{
+    D3D12_HEAP_PROPERTIES hp = {};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {};
+    rd.Dimension        = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width            = w;
+    rd.Height           = h;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels        = 1;
+    rd.Format           = g.output_fmt;
+    rd.SampleDesc.Count = 1;
+    rd.Layout           = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    rd.Flags            = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    for (int i = 0; i < 2; ++i)
+    {
+        const HRESULT hr = g.dev12->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COMMON,
+                                                            nullptr, __uuidof(ID3D12Resource),
+                                                            reinterpret_cast<void **>(&g_nr_tex[i]));
+        if (FAILED(hr) || g_nr_tex[i] == nullptr)
+        { Log("[feed] nr: cascade texture %d (%ux%u %s) failed 0x%08X", i, w, h, FormatName(g.output_fmt), hr); return false; }
+    }
+    return true;
+}
+
+// Os parametros que nao mudam de um quadro para o outro. Mesma ordem e mesmos tipos
+// da rotina de avaliacao do add-on de terceiros (0x180076840..0x180076dd9).
+static void NrSetStaticParams(UINT w, UINT h)
+{
+    NVSDK_NGX_Parameter *p = g_nr_params;
+    p->Set("DLSSNR.Width",         w);
+    p->Set("DLSSNR.Height",        h);
+    p->Set("DLSSNR.InputWidth",    w);
+    p->Set("DLSSNR.InputHeight",   h);
+    p->Set("DLSSNR.OutputWidth",   w);
+    p->Set("DLSSNR.OutputHeight",  h);
+    p->Set("DLSSNR.Output.Width",  w);
+    p->Set("DLSSNR.Output.Height", h);
+    p->Set("DLSSNR.Enabled",   1);
+    // Controles de estilo nos defaults do binario (o add-on parte de 1 em todos).
+    p->Set("DLSSNR.Intensity",                1.0f);
+    p->Set("DLSSNR.LocalToneStrength",        1.0f);
+    p->Set("DLSSNR.LocalStructureStrength",   1.0f);
+    p->Set("DLSSNR.GlobalToneStrength",       1.0f);
+    p->Set("DLSSNR.SkinStructureStrength",    1.0f);
