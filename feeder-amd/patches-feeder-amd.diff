+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrInitExt)(unsigned long long, const wchar_t *, ID3D12Device *,
+                                                     NVSDK_NGX_Version, const NVSDK_NGX_Parameter *);
+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrCreate)(ID3D12GraphicsCommandList *, NVSDK_NGX_Feature,
+                                                    NVSDK_NGX_Parameter *, NVSDK_NGX_Handle **);
+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrRelease)(NVSDK_NGX_Handle *);
+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrShutdown1)(ID3D12Device *);
+typedef NVSDK_NGX_Result (NVSDK_CONV *PFN_NrEvaluate)(ID3D12GraphicsCommandList *, const NVSDK_NGX_Handle *,
+                                                      const NVSDK_NGX_Parameter *, void *);
+
+// ---------------------------------------------------------------------------
+// Estado do Neural Rendering, PERSISTENTE entre quadros.
+//
+// Ate aqui o spike criava e soltava a feature na mesma chamada, so para responder
+// se ela criava. Para avaliar por quadro ela tem de viver: handle, mapa de
+// parametros e as duas texturas da cascata sobrevivem entre quadros e so morrem em
+// NrShutdown (rebuild da feature de SR, ou teardown da sessao).
+//
+// As duas texturas sao um ping-pong: o passe 1 le o OUTPUT do SuperSampling e
+// escreve em tex[0]; o passe 2 le tex[0] e escreve em tex[1], e assim por diante.
+// No fim o resultado do ultimo passe volta por copia para o SLOT_OUTPUT, que e de
+// onde o caminho ja existente leva o quadro para casa. E o contrato que o add-on
+// de terceiros descreve: os passes adicionais consomem a saida do anterior, e a
+// preparacao da fonte e a composicao do resultado acontecem uma vez so.
+// ---------------------------------------------------------------------------
+static NVSDK_NGX_Handle    *g_nr_feature;
+static NVSDK_NGX_Parameter *g_nr_params;
+static ID3D12Resource      *g_nr_tex[2];
+static UINT                 g_nr_w, g_nr_h;
+static bool                 g_nr_live;      // feature criada e texturas prontas
+static bool                 g_nr_failed;    // desligado apos falha; nao tenta de novo
+static LONGLONG             g_nr_win_ticks; // custo acumulado na janela de 600 quadros
+static UINT64               g_nr_win_frames;
+static UINT64               g_nr_win_passes;
+
+// Os cinco exports de ciclo de vida que o add-on de terceiros exige do snippet.
+// EvaluateFeature nao e usado aqui -- este spike so cria e solta --, mas e
+// resolvido junto porque a sua ausencia significa que o DLL nao serve, e e
+// melhor descobrir isso agora que na proxima etapa.
+enum { NR_INIT_EXT = 0, NR_CREATE, NR_EVALUATE, NR_RELEASE, NR_SHUTDOWN1, NR_EXPORT_COUNT };
+static const char *const kNrExports[NR_EXPORT_COUNT] = {
+    "NVSDK_NGX_D3D12_Init_Ext",
+    "NVSDK_NGX_D3D12_CreateFeature",
+    "NVSDK_NGX_D3D12_EvaluateFeature",
+    "NVSDK_NGX_D3D12_ReleaseFeature",
+    "NVSDK_NGX_D3D12_Shutdown1",
+};
+
+static HMODULE g_nr_snippet;                  // HMODULE do nvngx_dlssnr.dll enquanto o spike roda
+static bool    g_nr_snippet_was_loaded;       // ja estava no processo antes de nos (ver NrDetachSnippet)
+static FARPROC g_nr_fn[NR_EXPORT_COUNT];
+
+// ---------------------------------------------------------------------------
+// Verificacao de identidade do chamador, e como o add-on de terceiros a satisfaz.
+//
+// O 0xBAD00002 (PlatformError) do Init_Ext veio de DENTRO do snippet, nao do core:
+// desmontando o nvngx_dlssnr.dll (export Init_Ext em 0x180015df0) ve-se que a
+// primeira coisa que ele faz e descobrir QUEM o chamou e recusar se nao for "o
+// runtime do NGX":
+//
+//   GetModuleHandleExA(FROM_ADDRESS|UNCHANGED_REFCOUNT, <return address>, &hCaller)
+//       -> falha  => 0xBAD00002 + "Error: Unable to determine calling module"
+//   GetModuleFileNameW(hCaller, buf, 0x104)
+//   wcsstr(buf, L"nvngx.dll")                              (a busca em 0x18007ee40)
+//       -> nao acha => 0xBAD00002 + "Error: Not called from NGX runtime - %S"
+//
+// O return address, quando somos nos que chamamos, cai no NOSSO add-on
+// (dlss5-feed-amd.addon64), cujo nome nao contem "nvngx.dll". Dai o PlatformError,
+// com e sem o concorrente na pasta -- e por isso independe dele.
+//
+// O add-on de terceiros contorna isso exatamente como abaixo (rotina em
+// 0x18002ab60: varre a IAT procurando o slot de GetModuleFileNameW, faz
+// VirtualProtect e troca por um trampolim seu que, para o modulo dele, devolve
+// "nvngx.dll"). Fazemos o minimo equivalente: enquanto o snippet esta anexado,
+// interceptamos SO a entrada GetModuleFileNameW da IAT DELE (nao a de nenhum outro
+// modulo, nao um hook global) e, quando ele pergunta o nome do NOSSO modulo,
+// respondemos com o caminho do _nvngx.dll do core do driver -- cujo nome de arquivo
+// contem "nvngx.dll", que e o que a verificacao exige. Isto e interoperabilidade
+// com uma runtime que o usuario ja tem instalada, restrita a este spike; nenhum
+// outro chamador de GetModuleFileNameW no processo e afetado.
+// ---------------------------------------------------------------------------
+typedef DWORD (WINAPI *PFN_GetModuleFileNameW)(HMODULE, LPWSTR, DWORD);
+static PFN_GetModuleFileNameW g_nr_real_gmfnw;   // valor original do slot (pode ser o trampolim do concorrente)
+static void                 **g_nr_gmfnw_slot;   // endereco do slot na IAT do snippet
+
+static DWORD WINAPI NrGetModuleFileNameW_Thunk(HMODULE h, LPWSTR buf, DWORD n)
+{
+    // Somente a pergunta "quem me chamou?" e respondida de forma diferente, e so
+    // quando a resposta seria o nosso proprio modulo. Qualquer outra vai intacta.
+    if (h == g_self && g_nr_real_gmfnw != nullptr)
+    {
+        const HMODULE core = NrDriverCore();
+        DWORD wrote = 0;
+        if (core != nullptr) wrote = g_nr_real_gmfnw(core, buf, n);
+        if (wrote != 0 && wrote < n) return wrote;   // caminho do _nvngx.dll -> contem "nvngx.dll"
+    }
+    return g_nr_real_gmfnw != nullptr ? g_nr_real_gmfnw(h, buf, n)
+                                      : GetModuleFileNameW(h, buf, n);
+}
+
+// Acha o slot da IAT de 'mod' que resolve 'func' (de qualquer DLL importada:
+// GetModuleFileNameW pode vir de kernel32 ou de um api-set, entao casa so pelo
+// nome da funcao). Devolve o endereco do ponteiro, para reescrita.
+static void **NrFindIatSlot(HMODULE mod, const char *func)
+{
+    BYTE *base = reinterpret_cast<BYTE *>(mod);
+    const IMAGE_DOS_HEADER *dos = reinterpret_cast<IMAGE_DOS_HEADER *>(base);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE) return nullptr;
+    const IMAGE_NT_HEADERS *nt = reinterpret_cast<IMAGE_NT_HEADERS *>(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE) return nullptr;
+    const IMAGE_DATA_DIRECTORY dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    if (dir.VirtualAddress == 0) return nullptr;
+    for (const IMAGE_IMPORT_DESCRIPTOR *imp = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR *>(base + dir.VirtualAddress);
+         imp->Name != 0; ++imp)
+    {
+        if (imp->OriginalFirstThunk == 0) continue;   // sem ILT nao da para ler os nomes
+        const IMAGE_THUNK_DATA *oft = reinterpret_cast<IMAGE_THUNK_DATA *>(base + imp->OriginalFirstThunk);
+        IMAGE_THUNK_DATA       *ft  = reinterpret_cast<IMAGE_THUNK_DATA *>(base + imp->FirstThunk);
+        for (; oft->u1.AddressOfData != 0; ++oft, ++ft)
+        {
+            if (oft->u1.Ordinal & IMAGE_ORDINAL_FLAG64) continue;
+            const IMAGE_IMPORT_BY_NAME *ibn = reinterpret_cast<IMAGE_IMPORT_BY_NAME *>(base + oft->u1.AddressOfData);
+            if (strcmp(reinterpret_cast<const char *>(ibn->Name), func) == 0)
+                return reinterpret_cast<void **>(&ft->u1.Function);
+        }
+    }
+    return nullptr;
+}
+
+static void NrInstallCallerSpoof()
+{
+    g_nr_gmfnw_slot = NrFindIatSlot(g_nr_snippet, "GetModuleFileNameW");
+    if (g_nr_gmfnw_slot == nullptr)
+    { Log("[feed] nr_spike: could not find the snippet's GetModuleFileNameW import; the caller-identity check will fail"); return; }
+    DWORD prot = 0;
+    if (!VirtualProtect(g_nr_gmfnw_slot, sizeof(void *), PAGE_READWRITE, &prot))
+    { Log("[feed] nr_spike: VirtualProtect on the IAT slot failed (error %lu)", GetLastError()); g_nr_gmfnw_slot = nullptr; return; }
+    g_nr_real_gmfnw = reinterpret_cast<PFN_GetModuleFileNameW>(*g_nr_gmfnw_slot);
+    *g_nr_gmfnw_slot = reinterpret_cast<void *>(&NrGetModuleFileNameW_Thunk);
+    VirtualProtect(g_nr_gmfnw_slot, sizeof(void *), prot, &prot);
+}
+
+static void NrRemoveCallerSpoof()
+{
+    if (g_nr_gmfnw_slot == nullptr) return;
+    DWORD prot = 0;
+    if (VirtualProtect(g_nr_gmfnw_slot, sizeof(void *), PAGE_READWRITE, &prot))
+    {
+        *g_nr_gmfnw_slot = reinterpret_cast<void *>(g_nr_real_gmfnw);   // devolve o valor original (real ou o do concorrente)
+        VirtualProtect(g_nr_gmfnw_slot, sizeof(void *), prot, &prot);
+    }
+    g_nr_gmfnw_slot = nullptr;
+    g_nr_real_gmfnw = nullptr;
+}
+
+// O callback do mapa. Copia do que o add-on de terceiros faz: razao 1:1, e
+// InvalidParameter se o NGX chamar sem mapa.
+static NVSDK_NGX_Result NrScalingRatioCallback(NVSDK_NGX_Parameter *p)
+{
+    if (p == nullptr) return NVSDK_NGX_Result_FAIL_InvalidParameter;
+    p->Set("DLSSNR.ScalingRatio", 1.0f);
+    return NVSDK_NGX_Result_Success;
+}
