@@ -13,6 +13,31 @@
 	constexpr bool operator==(name lhs, name rhs) { return lhs.handle == rhs.handle; } \
 	constexpr bool operator==(name lhs, uint64_t rhs) { return lhs.handle == rhs; }
 
+// ---- shim de ABI MinGW <-> MSVC (variante AMD do DLSS5-Feeder; so com g++) -----------
+// O MSVC devolve QUALQUER struct de uma funcao-membro por ponteiro oculto em RDX (this em
+// RCX). O g++ devolve structs de 8 bytes em RAX e, quando usa ponteiro oculto, poe-no em
+// RCX, ANTES do this. Chamar find_technique() do ReShade (MSVC) a partir do g++ escreve o
+// handle em cima do primeiro argumento: violacao de acesso (confirmado por desmontagem no
+// dxgi.dll 6.8.0.2155 e pelo crash em "runtime init: find_technique"). Os oito metodos
+// virtuais da API que devolvem struct por valor sao portanto chamados por thunk com a
+// convencao do MSVC (this, sret, args...); o slot vem do ponteiro-para-membro (ABI Itanium
+// do g++: ptr = 1 + offset do slot na vtable). Parametros struct de 8 bytes continuam em
+// registrador nas duas ABIs, entao os demais metodos ficam como estao.
+#if defined(__GNUC__) && !defined(__clang__)
+#include <cstdint>
+#include <cstddef>
+#define RESHADE_MINGW_ABI_SHIM 1
+namespace reshade { namespace api { namespace mingw_abi {
+	template <typename M> inline int slot(M pmf)
+	{
+		union { M m; struct { uintptr_t ptr; ptrdiff_t adj; } r; } u;
+		u.m = pmf;
+		return static_cast<int>((u.r.ptr - 1) / sizeof(void *));
+	}
+	inline void *entry(const void *self, int index) { return (*reinterpret_cast<void *const *const *>(self))[index]; }
+} } }
+#endif
+
 #define RESHADE_DEFINE_ENUM_FLAG_OPERATORS(type) \
 	constexpr type operator~(type a) { return static_cast<type>(~static_cast<uint32_t>(a)); } \
 	inline type &operator&=(type &a, type b) { return reinterpret_cast<type &>(reinterpret_cast<uint32_t &>(a) &= static_cast<uint32_t>(b)); } \
