+    p->Set("DLSSNR.Style",         0u);
+    p->Set("DLSSNR.UICorrection",  0);
+    p->Set("DLSS.Indicator.Invert.X.Axis", 0);
+    p->Set("DLSS.Indicator.Invert.Y.Axis", 0);
