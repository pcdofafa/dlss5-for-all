+static void NrDetachSnippet(bool session)
+{
+    if (g_nr_snippet == nullptr) return;
+    // O Shutdown1 tambem passa pela verificacao de identidade do chamador -- e o
+    // 0xBAD00002 que ele devolvia era o MESMO erro do Init_Ext, nao um capricho do
+    // snippet. Por isso o spoof so sai depois: todo o ciclo que fala com o snippet
+    // (Init_Ext, CreateFeature, ReleaseFeature, Shutdown1) tem de acontecer sob ele.
+    // Com o Shutdown1 falhando, a instancia ficava aberta e o FreeLibrary logo
+    // abaixo descarregava o modulo por baixo dela.
+    if (session)
+    {
+        if (g_nr_snippet_was_loaded)
+            Log("[feed] nr_spike: skipping the snippet Shutdown1 -- another add-on holds a session on the same module");
+        else
+        {
+            DWORD scode = 0;
+            const NVSDK_NGX_Result rs = NrShutdownGuarded(&scode);
+            if (scode != 0) Log("[feed] nr_spike: snippet Shutdown1 raised exception 0x%08X (ignored)", scode);
+            else            Log("[feed] nr_spike: snippet Shutdown1 -> 0x%08X (%s)", rs, NgxResultName(rs));
+        }
+    }
+    NrRemoveCallerSpoof();   // restaura a IAT do snippet, ja com tudo dito e feito
+    FreeLibrary(g_nr_snippet);
+    g_nr_snippet            = nullptr;
+    g_nr_snippet_was_loaded = false;
+    for (int i = 0; i < NR_EXPORT_COUNT; ++i) g_nr_fn[i] = nullptr;
+}
+
+// Monta o Neural Rendering para o tamanho de saida dado, uma vez. w/h sao o tamanho
+// de SAIDA do feature de SuperSampling: o passe neural roda depois dele, sobre a
+// imagem ja reconstruida. Mapa de parametros proprio: g.params carrega o estado do
+// SR e as chaves do Chicken, e nada disto pode encostar nele.
+static void NrEnsure(UINT w, UINT h)
+{
+    if (g_cfg.nr_spike == 0 || g_nr_failed) return;
+    if (g_nr_live && g_nr_w == w && g_nr_h == h) return;
+    if (g_nr_live) NrShutdown();   // mudou de tamanho: refaz
+    g_nr_failed = true;            // so volta a false quando tudo der certo
+
+    const unsigned int preset  = 1;   // DLSSNR.Hint.Render.Preset: o que o log do add-on mostra
+    const int          quality = static_cast<int>(NVSDK_NGX_PerfQuality_Value_DLAA);
+
+    const LONGLONG t_begin = NrNow();
+    if (g.dev12 == nullptr || g.list == nullptr) { Log("[feed] nr_spike: no D3D12 device or command list"); return; }
+
+    wchar_t dir[MAX_PATH] = {};
+    if (!NrAttachSnippet(dir, MAX_PATH)) { NrDetachSnippet(false); return; }
+    const LONGLONG t_attach = NrNow();
+
+    // Passos 1 e 2 -- o diretorio de dados e o Init do NGX core do driver -- nao
+    // existem mais, e isso esta MEDIDO, nao suposto.
+    //
+    // O Init do core entrou no spike na mesma rodada em que o PlatformError ainda
+    // estava de pe, e o PlatformError vinha da verificacao de identidade do
+    // chamador, nao do core: quem destravou o Init_Ext foi o spoof de
+    // GetModuleFileNameW. O snippet e autocontido --
+    //   - o nvngx_dlssnr.dll importa exatamente VERSION, ADVAPI32, USER32 e
+    //     KERNEL32; nada de nvngx.dll/_nvngx.dll;
+    //   - a unica ocorrencia da string L"nvngx.dll" nele e a agulha da propria
+    //     verificacao de identidade; ele nunca carrega nem resolve nada no core
+    // -- e o run sem o Init confirmou: Init_Ext, CreateFeature e Shutdown1 todos
+    // Success, com o Super Resolution intacto a 60 fps.
+    //
+    // O ganho nao e so uma chamada a menos: sem esse Init, o spike nao toca a
+    // sessao NGX do SR em ponto nenhum. O mapa de parametros continua vindo do
+    // core, mas quem o inicializou foi o feed.
+    //
+    // NrPrepareDataDir e NrCoreInitGuarded seguem definidas, sem chamador, como
+    // registro do caminho que o add-on de terceiros usa -- e caso um dia um
+    // snippet diferente volte a exigi-lo.
+    const LONGLONG t_core = NrNow();
+
+    // Passo 3: a sessao do snippet, separada da do core: outro modulo, outro estado.
+    DWORD icode = 0;
+    Breadcrumb("initialising the Neural Rendering snippet (nr_spike)");
+    const NVSDK_NGX_Result ri = NrInitExtGuarded(dir, &icode);
+    if (icode != 0)
+    {
+        Log("[feed] nr_spike: snippet Init_Ext raised exception 0x%08X (caught)", icode);
+        NrDetachSnippet(false);
+        return;
+    }
+    Log("[feed] nr_spike: snippet Init_Ext(app=0x%08llX, %ls, sdk=0x%X) -> 0x%08X (%s)",
+        kNrApplicationId, dir, static_cast<unsigned>(NVSDK_NGX_Version_API), ri, NgxResultName(ri));
+    if (NVSDK_NGX_FAILED(ri)) { NrDetachSnippet(false); return; }
+    const LONGLONG t_initext = NrNow();
+
+    // O mapa vem do DRIVER (o snippet nao exporta AllocateParameters), exatamente
+    // como o add-on de terceiros faz. E o unico objeto que atravessa a fronteira
+    // entre as duas metades.
+    NVSDK_NGX_Parameter *p = nullptr;
+    NVSDK_NGX_Result r = NVSDK_NGX_D3D12_AllocateParameters(&p);
+    if (NVSDK_NGX_FAILED(r) || p == nullptr)
+    {
+        Log("[feed] nr_spike: AllocateParameters failed 0x%08X (%s)", r, NgxResultName(r));
+        NrDetachSnippet(true);
+        return;
+    }
+
+    // Genericos do NGX (headers publicos).
+    p->Set(NVSDK_NGX_Parameter_CreationNodeMask,   1u);
+    p->Set(NVSDK_NGX_Parameter_VisibilityNodeMask, 1u);
+    p->Set(NVSDK_NGX_Parameter_Width,     w);
+    p->Set(NVSDK_NGX_Parameter_Height,    h);
+    p->Set(NVSDK_NGX_Parameter_OutWidth,  w);
+    p->Set(NVSDK_NGX_Parameter_OutHeight, h);
+    // Os quatro pares de dimensoes do DLSS-NR, todos com o mesmo tamanho.
+    p->Set("DLSSNR.Width",         w);
+    p->Set("DLSSNR.Height",        h);
+    p->Set("DLSSNR.InputWidth",    w);
+    p->Set("DLSSNR.InputHeight",   h);
+    p->Set("DLSSNR.OutputWidth",   w);
+    p->Set("DLSSNR.OutputHeight",  h);
+    p->Set("DLSSNR.Output.Width",  w);
+    p->Set("DLSSNR.Output.Height", h);
+    p->Set("DLSSNR.Hint.Render.Preset", preset);
+    p->Set(NVSDK_NGX_Parameter_PerfQualityValue, quality);
+    p->Set("DLSSNRComputeScalingRatioCallback", reinterpret_cast<void *>(&NrScalingRatioCallback));
+    p->Set("DLSSNR.ScalingRatio", 1.0f);
+    p->Set("DLSSNR.Scale",        1.0f);
+    p->Set("DLSSNR.Upscaling",    0);
+
+    if (!NrBeginCommands())
+    {
+        Log("[feed] nr_spike: could not start a command list");
+        NVSDK_NGX_D3D12_DestroyParameters(p);
+        NrDetachSnippet(true);
+        return;
+    }
+
+    Breadcrumb("creating the Neural Rendering feature (nr_spike)");
+    NVSDK_NGX_Handle *feature = nullptr;
+    DWORD ccode = 0;
+    r = CreateNrGuarded(p, &feature, &ccode);
+    if (ccode != 0)
+    {
+        NrAbortCommands();   // trabalho NGX pela metade nunca pode chegar na GPU
+        Log("[feed] nr_spike: CreateFeature(Reserved18) raised exception 0x%08X (caught; nothing was submitted)", ccode);
+        NVSDK_NGX_D3D12_DestroyParameters(p);
+        NrDetachSnippet(true);
+        return;
+    }
+    NrEndCommandsAndWait();
+    const LONGLONG t_create = NrNow();
+    if (NVSDK_NGX_FAILED(r) || feature == nullptr)
+    {
+        Log("[feed] nr: CreateFeature(Reserved18) failed 0x%08X (%s), handle=%p, size=%ux%u perfquality=%d preset=%u",
+            r, NgxResultName(r), static_cast<void *>(feature), w, h, quality, preset);
+        NVSDK_NGX_D3D12_DestroyParameters(p);
+        NrDetachSnippet(true);
+        return;
+    }
+    Log("[feed] nr: CreateFeature(Reserved18) succeeded: handle=%p size=%ux%u perfquality=%d preset=%u",
+        static_cast<void *>(feature), w, h, quality, preset);
+
+    // As texturas da cascata. Se falharem, desmonta tudo -- meia montagem nao serve.
+    if (!NrCreateTextures(w, h))
+    {
+        NrReleaseGuarded(feature);
+        SafeRelease(g_nr_tex[0]);
+        SafeRelease(g_nr_tex[1]);
+        NVSDK_NGX_D3D12_DestroyParameters(p);
+        NrDetachSnippet(true);
+        return;
+    }
+
+    // A partir daqui o NR esta de pe e o estado sobrevive ao retorno.
+    g_nr_feature       = feature;
+    g_nr_params        = p;
+    g_nr_w             = w;
+    g_nr_h             = h;
+    g_nr_live          = true;
+    g_nr_failed        = false;
+    g_nr_reset_history = true;
+    NrSetStaticParams(w, h);
+    const LONGLONG t_end = NrNow();
+    Log("[feed] nr: ready at %ux%u %s, %d pass%s per frame | setup ms: attach=%.2f init_ext=%.2f create=%.2f total=%.2f",
+        w, h, FormatName(g.output_fmt), g_cfg.nr_passes, g_cfg.nr_passes == 1 ? "" : "es",
+        NrMs(t_attach - t_begin), NrMs(t_initext - t_core), NrMs(t_create - t_initext), NrMs(t_end - t_begin));
+}
