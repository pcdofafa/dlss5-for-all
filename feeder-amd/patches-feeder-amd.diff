+// ---------------------------------------------------------------------------
+// Spike do Neural Rendering (nr_spike=1 no dlss5-feed.cfg; desligado por padrao)
+//
+// Pergunta unica: o NOSSO processo consegue criar o feature NGX Reserved18 -- o
+// DLSS-NR, o passe neural que hoje so o add-on de terceiros cria? Cria uma vez,
+// loga o codigo de retorno e solta. Nao avalia, nao guarda o handle, nao entra
+// no caminho do quadro.
+//
+// A receita abaixo nao vem de header nenhum: os nomes "DLSSNR.*" nao existem no
+// SDK publico da NVIDIA. Ela foi lida do proprio renodx-dlss.addon64 desta pasta
+// (a rotina de create em 0x180077e5f..0x180078088), que e a unica implementacao
+// que comprovadamente funciona nesta maquina. Ordem, tipo e valor de cada Set
+// batem com o que ele faz -- inclusive dois detalhes que so o desmontado conta:
+//
+//  - o log dele diz "performance=6", mas o que ele passa em PerfQualityValue e
+//    esse numero MENOS UM (mov r8d,[perf]; dec r8d), ou seja 5, que e
+//    NVSDK_NGX_PerfQuality_Value_DLAA. O "6" e a contagem 1-based da interface
+//    dele, nao um valor de NGX (o enum publico vai ate 5);
+//  - "DLSSNRComputeScalingRatioCallback" nao e um numero: e um PONTEIRO DE
+//    FUNCAO guardado no mapa de parametros. O NGX o chama passando o proprio
+//    mapa e espera que ele grave DLSSNR.ScalingRatio. O add-on grava a razao
+//    tambem direto, antes do create; fazemos os dois, igual a ele.
+//
+// Tudo 1:1 (mesma largura e altura em cada par de dimensoes, Upscaling=0): o
+// passe neural roda DEPOIS do SuperSampling, sobre a imagem ja reconstruida.
+//
+// A PRIMEIRA tentativa deste spike chamou o CreateFeature do _nvngx.dll do driver
+// e levou 0xBAD0000C (OutOfDate = "requires a newer version of the driver OR
+// FEATURE LIBRARY"). O desmonte explica: o add-on de terceiros NAO usa o NGX do
+// driver para o passe neural. Ele monta a coisa em duas metades:
+//
+//   snippet          nvngx_dlssnr.dll carregado com LoadLibraryW; a tabela de
+//                    GetProcAddress em 0x180027b43.. resolve NELE os cinco
+//                    exports de ciclo de vida (Init_Ext, CreateFeature,
+//                    EvaluateFeature, ReleaseFeature, Shutdown1). O DLL exporta
+//                    mesmo a API NGX inteira -- e uma runtime autocontida, nao
+//                    um pacote de pesos. Se faltar um export ele da FreeLibrary
+//                    e desiste ("snippet is missing a required lifecycle export").
+//   parameter        _nvngx.dll do driver, de onde vem SO o objeto de parametros
+//   provider         (AllocateParameters/DestroyParameters, resolvidos em
+//                    0x180043fe1..0x18004400d). O snippet nao exporta esses.
+//
+// Ou seja: mapa de parametros do DRIVER, CreateFeature do SNIPPET. E antes disso
+// um Init_Ext no ponteiro do SNIPPET (0x18007624a..0x18007628a):
+//
+//     Init_Ext(0x0876232C, <diretorio do nvngx_dlssnr.dll>, device, 0x15, nullptr)
+//
+// com o diretorio derivado do caminho do proprio snippet (parent_path em
+// 0x18003d720) e o ultimo argumento -- que nesta sobrecarga do header e um
+// NVSDK_NGX_Parameter*, nao um FeatureCommonInfo* -- em NULL. Nao ha PathListInfo
+// nenhum. Isso e uma sessao NGX separada da do feed: modulos distintos, estados
+// distintos, o unico objeto compartilhado e o mapa de parametros.
+// ---------------------------------------------------------------------------
+
+// A segunda tentativa deste spike -- ja com o snippet anexado -- levou 0xBAD00002
+// (PlatformError) no Init_Ext, com e sem o add-on de terceiros na pasta. O desmonte
+// mostra que falta um passo INTEIRO antes: a funcao em 0x180043020, chamada em
+// 0x180076239, imediatamente antes do Init_Ext. Ela faz duas coisas:
+//
+//   1. prepara um diretorio de dados: GetTempPath2W (com fallback para GetTempPathW
+//      em 0x18013080a), confere que e diretorio (GetFileAttributesW & 0x10), anexa
+//      os componentes L"RenoDX" e L"dlssnr" (0x1802067c8/0x1802067d6) e cria a
+//      arvore componente a componente. Se falhar, loga "could not prepare NGX
+//      application-data directory ({})" e RETORNA FALSO -- o Init_Ext nem acontece.
+//   2. inicializa o NGX core DO DRIVER nesse diretorio (0x18004364b..0x180043679):
+//
+//        provider!NVSDK_NGX_D3D12_Init(0x0876232C, <temp>\RenoDX\dlssnr, device, 0x15)
+//
+//      quatro argumentos, nao cinco. O header tem as duas familias: a de cinco
+//      (com NVSDK_NGX_FeatureCommonInfo*) e, sob NGX_SNIPPET_BUILD, a de quatro,
+//      com a versao direto no 4o lugar. Quem fala com snippet usa a de quatro --
+//      o nome da macro diz isso -- e e a que o _nvngx.dll implementa de fato.
+//      Sucesso vira "backend-owned NVIDIA NGX core initialization succeeded".
+//
+// O feed ja inicializa o NGX do driver, mas com AppId 0x1000000 e o data path dele.
+// O snippet nao encontra uma sessao de core que case com o AppId e o diretorio que
+// lhe passamos, e responde PlatformError. Entao a sequencia completa e:
+//
+//     attach do snippet -> preparar o diretorio -> Init do CORE do driver
+//     -> Init_Ext do SNIPPET -> AllocateParameters do driver -> CreateFeature do snippet
+//
+// A minha chamada do Init_Ext ja estava certa (r9d=0x15, quinto argumento NULL na
+// pilha, exatamente como ele): o que faltava eram os dois passos acima.
+// ---------------------------------------------------------------------------
+
+// AppId que o add-on passa NAS DUAS inicializacoes -- a do core e a do snippet
+// (literais em 0x18004366e e 0x180076278). Nao e um valor documentado; e o que
+// comprovadamente funciona nesta maquina, e o snippet parece exigir que o core
+// tenha sido inicializado com o MESMO.
+static const unsigned long long kNrApplicationId = 0x0876232CULL;
+static const wchar_t           *kNrSnippetName   = L"nvngx_dlssnr.dll";
+
+// Os dois componentes do diretorio de dados, sob o %TEMP%. Sao deliberadamente os
+// mesmos que o add-on de terceiros usa: o principio que vem acertando neste spike e
+// "identico ao que funciona". Se o Init_Ext ainda recusar, este e o primeiro
+// parametro a variar -- e o mais barato de testar.
+static const wchar_t *kNrDataSubdir[] = { L"RenoDX", L"dlssnr" };
+
+#ifdef FEED_AMD_VARIANT
+extern "C" HMODULE NgxForwardModule();   // src-amd/ngx_forward.cpp
+#endif
+
+// O NGX core do driver. Na variante AMD o forwarder ja o resolveu (e sabe achar o
+// _nvngx.dll pelo registro); fora dela, o feed linka a lib estatica da NVIDIA e o
+// modulo ja esta no processo quando esta funcao roda.
+static HMODULE NrDriverCore()
+{
+#ifdef FEED_AMD_VARIANT
+    if (HMODULE m = NgxForwardModule()) return m;
+#endif
+    HMODULE m = GetModuleHandleW(L"_nvngx.dll");
+    if (m == nullptr) m = GetModuleHandleW(L"nvngx.dll");
+    return m;
+}
+
+// %TEMP%\RenoDX\dlssnr, criado se preciso. Mesma receita da funcao 0x180043020.
+static bool NrPrepareDataDir(wchar_t *out, size_t chars)
+{
+    wchar_t base[MAX_PATH] = {};
+    const DWORD n = GetTempPathW(MAX_PATH, base);
+    if (n == 0 || n >= MAX_PATH) { Log("[feed] nr_spike: GetTempPathW failed (error %lu)", GetLastError()); return false; }
+    // O TEMP vem com barra no fim; o parent_path que o add-on monta nao tem.
+    size_t len = wcslen(base);
+    while (len > 0 && (base[len - 1] == L'\\' || base[len - 1] == L'/')) base[--len] = L'\0';
+    if (len == 0) { Log("[feed] nr_spike: GetTempPathW returned a root-only path"); return false; }
+    if (wcsncpy_s(out, chars, base, _TRUNCATE) != 0) return false;
+    for (const wchar_t *part : kNrDataSubdir)
+    {
+        if (wcscat_s(out, chars, L"\\") != 0 || wcscat_s(out, chars, part) != 0)
+        { Log("[feed] nr_spike: the NGX application-data path does not fit in MAX_PATH"); return false; }
+        if (!CreateDirectoryW(out, nullptr) && GetLastError() != ERROR_ALREADY_EXISTS)
+        { Log("[feed] nr_spike: could not prepare the NGX application-data directory %ls (error %lu)", out, GetLastError()); return false; }
+    }
+    const DWORD attr = GetFileAttributesW(out);
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY) == 0)
+    { Log("[feed] nr_spike: %ls is not a directory", out); return false; }
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Por que o NR corre no device do feed, e nao num device proprio.
+//
+// A sessao do NGX e POR DEVICE: o header e explicito ("most NGX SDK functions
+// require the NGX SDK to be initialized for the corresponding graphics API and
+// device") e o Shutdown1 so aceita um device para desambiguar. A conclusao obvia
+// seria dar ao NR um ID3D12Device proprio, no mesmo adaptador, para isolar a
+// sessao dele da do Super Resolution. Isso chegou a ser implementado -- e nao
+// funciona, porque a premissa e falsa:
+//
+//   O RUNTIME D3D12 RECICLA O DEVICE POR ADAPTADOR. D3D12CreateDevice com o mesmo
+//   adaptador e o mesmo feature level devolve S_OK e o MESMO OBJETO, so com o
+//   refcount incrementado -- inclusive quando o IDXGIAdapter1 e outro objeto,
+//   vindo de EnumAdapterByLuid. A identidade COM (QueryInterface de IUnknown)
+//   confirma. Medido nesta maquina por tests/nr_device_probe.cpp, que existe
+//   para alguem reconferir isto sem precisar do jogo.
+//
+// Ou seja: um "device privado" nao isolaria nada -- a sessao NGX seria a mesma --
+// e ainda soltaria, no teardown, uma referencia do device do SR. O codigo que
+// fazia isso foi REMOVIDO em vez de desligado: codigo que finge criar um device e
+// na verdade mexe no refcount alheio engana quem le depois.
+//
+// O NR entao vive no g.dev12, com o desenho endurecido: nenhum Init no core do
+// driver (o snippet e autocontido -- ver o passo 2 em NeuralRenderingSpike),
+// nenhum Shutdown1 do core NUNCA, e o spoof de identidade cobrindo o ciclo
+// inteiro. O unico Shutdown1 que damos e o do SNIPPET, que e outro modulo com
+// outra tabela de instancias e nao alcanca a sessao do Super Resolution.
+//
+// A sessao do NGX e POR DEVICE, nao por chamador nem por ApplicationId. O header
+// e explicito: "Most NGX SDK functions require the NGX SDK to be initialized for
+// the corresponding graphics API and device", e o Shutdown1 so aceita um device
+// para desambiguar ("if a device is provided, shuts down the instance
+// corresponding to the specified device; if nullptr is provided, ALL instances
+// are shut down"). Se a sessao fosse por chamador, o Shutdown1 precisaria de outro
+// identificador -- e nao tem.
+//
+// Consequencia: os dois Init que faziamos no g.dev12 nao abriam duas sessoes. Eles
+// RECONFIGURAVAM a mesma instancia -- trocando ApplicationId e data path por baixo
+// de um feature de SuperSampling vivo e em uso. Por isso o spike, mesmo "isolado",
+// alcancava o SR.
+//
+// Entao o NR ganha o seu proprio device, no MESMO adaptador (mesma LUID: o passe
+// neural precisa enxergar os mesmos recursos), com fila, allocator, lista e fence
+// proprios. Nada abaixo toca no g.dev12, e o Shutdown1 daqui so pode derrubar a
+// instancia deste device. nullptr nunca e passado a Shutdown1 -- derrubaria o NGX
+// do processo inteiro, SR incluido.
+// ---------------------------------------------------------------------------
+// Cronometragem das etapas. Tudo em CPU (QueryPerformanceCounter); o tempo do
+// create inclui a espera da fence, entao cobre o trabalho de GPU tambem.
+static LARGE_INTEGER g_nr_qpc_freq;
+static double NrMs(LONGLONG ticks)
+{
+    if (g_nr_qpc_freq.QuadPart == 0) QueryPerformanceFrequency(&g_nr_qpc_freq);
+    return g_nr_qpc_freq.QuadPart != 0
+         ? static_cast<double>(ticks) * 1000.0 / static_cast<double>(g_nr_qpc_freq.QuadPart)
+         : 0.0;
+}
+static LONGLONG NrNow()
+{
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return t.QuadPart;
+}
