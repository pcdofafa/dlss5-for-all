+
+// Avaliacao do Neural Rendering, uma vez por quadro, com nr_passes avaliacoes
+// encadeadas. Roda DENTRO do bloco BeginCommands/EndCommands do feed, logo depois do
+// evaluate do SuperSampling, na mesma command list -- mesmo device, sem recurso
+// compartilhado e sem sincronizacao entre filas.
+//
+// Contrato de estados. Na entrada, o SLOT_OUTPUT esta em UNORDERED_ACCESS (foi onde
+// o NGX do SR escreveu) e e isso que o caminho de volta espera encontrar na saida.
+// Entao: viramos o SLOT_OUTPUT para leitura, rodamos a cascata nas nossas texturas,
+// copiamos o resultado de volta e devolvemos o SLOT_OUTPUT a UNORDERED_ACCESS.
+//
+// Se qualquer coisa falhar, o NR se desliga (g_nr_failed) e a funcao volta sem tocar
+// no quadro: o SLOT_OUTPUT continua com a imagem do SuperSampling e o feed entrega o
+// quadro normalmente. O jogo nunca para por causa disto.
+static void NrEvaluateFrame(bool depth_inverted)
+{
+    if (!g_nr_live || g_cfg.nr_spike == 0) return;
+    const int passes = g_cfg.nr_passes < 1 ? 1 : (g_cfg.nr_passes > 10 ? 10 : g_cfg.nr_passes);
+    const LONGLONG t0 = NrNow();
+
+    NVSDK_NGX_Parameter *p = g_nr_params;
+    // Guias e jitter: exatamente o que o caminho do SR ja passa ao DLSS. O feed nao
+    // jittera (as texturas sao do tamanho de saida) e as escalas de MV sao as do cfg.
+    p->Set("DLSSNR.JitterOffsetX", 0.0f);
+    p->Set("DLSSNR.JitterOffsetY", 0.0f);
+    p->Set("DLSSNR.MVecScaleX",    g_cfg.mv_scale_x);
+    p->Set("DLSSNR.MVecScaleY",    g_cfg.mv_scale_y);
+    p->Set("DLSSNR.DepthInverted", depth_inverted ? 1 : 0);
+    p->Set("DLSSNR.MVec",  g.tex12[SLOT_MV]);
+    p->Set("DLSSNR.Depth", g.tex12[SLOT_DEPTH]);
+
+    // O SLOT_OUTPUT vira fonte do primeiro passe.
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                  D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(g_nr_tex[0], D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+
+    ID3D12Resource *src = g.tex12[SLOT_OUTPUT];
+    int dst_i = 0;
+    bool ok = true;
+    for (int i = 0; i < passes && ok; ++i)
+    {
+        if (i > 0)
+        {
+            // O destino do passe anterior vira a fonte deste; o outro vira destino.
+            Barrier(src,             D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                     D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+            Barrier(g_nr_tex[dst_i], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                                     D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        }
+        p->Set("DLSSNR.Color",  src);
+        p->Set("DLSSNR.Output", g_nr_tex[dst_i]);
+        // O Reset vale para o quadro, nao para o passe: so o primeiro o carrega.
+        p->Set("DLSSNR.Reset", (i == 0 && g_nr_reset_history) ? 1 : 0);
+
+        DWORD ecode = 0;
+        const NVSDK_NGX_Result re = NrEvaluateGuarded(&ecode);
+        if (ecode != 0)
+        {
+            Log("[feed] nr: evaluate raised exception 0x%08X on pass %d (caught); neural rendering off, the frame still ships",
+                ecode, i + 1);
+            ok = false;
+        }
+        else if (NVSDK_NGX_FAILED(re))
+        {
+            Log("[feed] nr: evaluate failed 0x%08X (%s) on pass %d; neural rendering off, the frame still ships",
+                re, NgxResultName(re), i + 1);
+            ok = false;
+        }
+        if (!ok) break;
+        src   = g_nr_tex[dst_i];
+        dst_i = 1 - dst_i;
+        ++g_nr_win_passes;
+    }
+    g_nr_reset_history = false;
+
+    if (!ok)
+    {
+        // Devolve o SLOT_OUTPUT ao estado que o caminho de volta espera e desiste.
+        // A imagem que segue e a do SuperSampling, intacta.
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                                      D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        g_nr_live   = false;
+        g_nr_failed = true;
+        return;
+    }
+
+    // Composicao: o resultado do ultimo passe volta para o SLOT_OUTPUT.
+    Barrier(src,                  D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
+    g.list->CopyResource(g.tex12[SLOT_OUTPUT], src);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Barrier(src,                  D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
+    // A textura que sobrou como destino nao usado volta ao estado neutro.
+    if (passes > 1)
+        Barrier(g_nr_tex[dst_i], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+
+    g_nr_win_ticks += NrNow() - t0;
+    ++g_nr_win_frames;
+}
