+
+// Todo o NR corre no device e na lista do feed -- as texturas de Color, Depth, MV
+// e Output ja estao la, o que na fase de avaliacao dispensa recurso compartilhado
+// e sincronizacao entre filas.
+static bool NrBeginCommands() { return BeginCommands(); }
+static void NrAbortCommands() { AbortCommands(); }
+
+static void NrEndCommandsAndWait()
+{
+    const UINT64 v = EndCommands();
+    if (g.fence12->GetCompletedValue() < v)
+    {
+        ResetEvent(g.fence_event);   // como em BeginCommands: nunca confiar num sinal antigo
+        g.fence12->SetEventOnCompletion(v, g.fence_event);
+        if (WaitForSingleObject(g.fence_event, 4000) != WAIT_OBJECT_0 || g.fence12->GetCompletedValue() < v)
+            Log("[feed] nr_spike: the create did not complete within 4 s (continuing)");
+    }
+}
