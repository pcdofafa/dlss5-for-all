+    {
+        g_ep_fence = nullptr;
+        Log("[feed] envio por passe: CreateFence falhou -- o pacote do quadro segue unico, como antes");
+        return false;
+    }
+    g_ep_event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (g_ep_event == nullptr) { SafeRelease(g_ep_fence); return false; }
