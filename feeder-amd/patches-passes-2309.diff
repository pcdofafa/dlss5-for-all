+static void EpRelease()
+{
+    SafeRelease(g_ep_fence);
+    g_ep_dev = nullptr;
+    if (g_ep_event != nullptr) { CloseHandle(g_ep_event); g_ep_event = nullptr; }
+    g_ep_sig = 0;
+    g_ep_off = false;
+    g_ep_lista_fechada = false;
+    g_ep_quebrado = false;
