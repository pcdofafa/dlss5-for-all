+                    static_cast<unsigned long long>(g_ep_sig), static_cast<unsigned long long>(g_ep_fence->GetCompletedValue()));
+            ++g_ep_avisos;
+        }
+    }
+    const double ms = EpMsDesde(t0);
+    g_ep_espera_soma_ms += ms;
+    if (ms > g_ep_espera_pior_ms) g_ep_espera_pior_ms = ms;
+    if (!pronto)
+    {
+        ++g_ep_estouros;
+        if (g_ep_avisos < 40 || g_ep_avisos % 100 == 0)
+            Log("[feed] AVISO envio por passe: %u ms sem vaga (%s) -- o pacote vai assim mesmo (nenhum quadro "
+                "descartado); fila feed.queue.direct, fence feed.fence.passe completed %llu de %llu",
+                timeout, onde, static_cast<unsigned long long>(g_ep_fence->GetCompletedValue()),
+                static_cast<unsigned long long>(g_ep_sig));
+        ++g_ep_avisos;
+    }
+    return true;
+}
