+    if (g_ep_sig < lim) return true;
+    const UINT64 alvo = g_ep_sig - (lim - 1);   // completed >= alvo  <=>  em voo <= lim - 1
+    if (g_ep_fence->GetCompletedValue() >= alvo) return true;
