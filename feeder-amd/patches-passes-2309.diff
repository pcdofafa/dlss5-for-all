+// Depois de CADA ExecuteCommandLists nosso com o envio por passe ligado.
+static void EpSinalizar()
+{
+    if (g_ep_fence == nullptr || g.queue == nullptr) return;
+    const UINT64 v = ++g_ep_sig;
+    g.queue->Signal(g_ep_fence, v);
+    ++g_ep_envios;
+    const UINT64 feito = g_ep_fence->GetCompletedValue();
+    const int voo = static_cast<int>(v > feito ? v - feito : 0);   // inclui o que acabou de sair
+    LARGE_INTEGER agora, f;
+    QueryPerformanceCounter(&agora);
+    QueryPerformanceFrequency(&f);
+    if (g_ep_seg_t0 == 0) g_ep_seg_t0 = agora.QuadPart;
+    else if (agora.QuadPart - g_ep_seg_t0 >= f.QuadPart)
+    {
+        if (g_ep_voo_hist_n < static_cast<int>(sizeof(g_ep_voo_hist) / sizeof(g_ep_voo_hist[0])))
+            g_ep_voo_hist[g_ep_voo_hist_n++] = g_ep_voo_seg;
+        else
+        {
+            for (int i = 1; i < g_ep_voo_hist_n; ++i) g_ep_voo_hist[i - 1] = g_ep_voo_hist[i];
+            g_ep_voo_hist[g_ep_voo_hist_n - 1] = g_ep_voo_seg;
+        }
+        g_ep_voo_seg = 0;
+        g_ep_seg_t0 = agora.QuadPart;
+    }
+    if (voo > g_ep_voo_seg) g_ep_voo_seg = voo;
+}
