+        // gpu_timeout_ms (2000) empata com ele. Quem le o log precisa saber a 500 ms e a
+        // 1000 ms que um pacote nosso esta preso -- e qual, pelo nome que o DRED tambem usa.
+        const bool marca500 = !aviso500 && esperado >= 500, marca1000 = !aviso1000 && esperado >= 1000;
