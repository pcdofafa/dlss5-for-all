+
+static bool EpEnsure()
+{
+    if (g_ep_fence != nullptr && g_ep_dev == g.dev12) return true;
+    if (g_ep_fence != nullptr) EpRelease();   // outro device: a fence velha nao serve a esta fila
+    if (g_ep_off || g.dev12 == nullptr || g.queue == nullptr) return false;
+    g_ep_off = true;   // so volta a false no fim, se tudo der certo
+    if (FAILED(g.dev12->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), reinterpret_cast<void **>(&g_ep_fence))) ||
