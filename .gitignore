# DLSS5 For All - o que NÃO entra no controle de versão.
# Critério: entra o que é fonte de verdade (código, shaders, documentação,
# arte de marca, scripts). Fica de fora tudo que é resultado de compilação,
# binário pesado de terceiros, cache, log ou cópia de segurança manual.

# --- Compilados e binários -------------------------------------------------
*.exe
*.dll
*.addon64
*.o
*.obj
*.res.o
*.lib
*.a
*.pdb
*.exp
*.ilk
*.zip
*.7z

# --- Saídas de build e de empacotamento ------------------------------------
feeder-amd/build/
feeder-amd/dist/
build/
dist/
saida/

# --- Cache de shaders gerado pelo ReShade (centenas de .asm/.cso) ----------
reshade-cache/

# --- Logs e estado de execução ---------------------------------------------
*.log
*.log.*
*.log[0-9]
instalacao-*.log

# --- Cópias de segurança manuais (.bak-*) ----------------------------------
# Não são histórico: o histórico agora é o próprio git.
*.bak
*.bak-*
*.bak.*
*.old
*.orig
*.rej

# --- Capturas de tela ------------------------------------------------------
capturas/
screenshots/
DLSS5 Screenshots/

# --- Repositório git de terceiros já versionado à parte --------------------
# feeder-amd/src-feeder é um clone de https://github.com/jlrouzies-fr/DLSS5-Feeder
# com histórico e remoto próprios. Versioná-lo aqui criaria um submódulo vazio.
# As alterações locais sobre ele estão registradas em
# feeder-amd/patches-feeder-amd.diff, que ESTE repositório versiona.
feeder-amd/src-feeder/

# --- Lixo do Windows -------------------------------------------------------
Thumbs.db
desktop.ini
*.tmp
~$*

# --- v2.1 PASTA UNICA: o mod DLSS-NR-on-AMD (terceiro, licenca proibe redistribuir) --------
# mora em bin\mod-amd\ na maquina da pessoa. Nada dele entra no git: so as instrucoes e o
# script de conferencia, que o montar-portable.ps1 copia para bin\mod-amd\.
mod-amd/*
!mod-amd/LEIA-ME.txt
!mod-amd/README.txt
!mod-amd/preparar-mod-amd.cmd
!mod-amd/preparar-mod-amd.ps1
bin/mod-amd/*
!bin/mod-amd/LEIA-ME.txt
!bin/mod-amd/README.txt
!bin/mod-amd/preparar-mod-amd.cmd
!bin/mod-amd/preparar-mod-amd.ps1
version.dll
dlssnr_on_amd*
!perfil-amd/dlssnr_on_amd.ini.referencia
